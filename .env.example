# ==============================================================================
# AI SEO Audit Team - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply your API keys:
# cp .env.example .env
# ==============================================================================

# --- Primary LLM Configuration (Google Gemini) ---
# Obtain from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY_1=optional_secondary_gemini_key_for_failover
SELECTED_MODEL=gemini-2.0-flash

# --- Web Scraping & Crawling Engines ---
# Firecrawl API for LLM-ready markdown extraction (https://www.firecrawl.dev)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Fallback Scraping Proxies (Optional)
SCRAPERAPI_KEY=your_scraperapi_key_here
APIFY_API_TOKEN=your_apify_api_token_here

# --- SERP & Competitive Search APIs ---
# SerpApi for Google Search competitive intelligence (https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# SearchApi alternative (Optional)
SEARCHAPI_API_KEY=your_searchapi_key_here

# --- Performance & Authority APIs ---
# Google PageSpeed Insights API Key (Optional, higher quota)
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Moz API for Domain Authority & Backlink Metrics (Optional)
MOZ_ACCESS_ID=your_moz_access_id_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# --- Database & Storage ---
# Defaults to SQLite if left empty
DATABASE_URL=sqlite:///data/seo_audit.db

# --- Commercial Billing & Subscriptions (Stripe) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRICE_STARTER=price_starter_id_here
STRIPE_PRICE_AGENCY=price_agency_id_here

# --- System & API Server ---
DEBUG=False
SECRET_KEY=generate_a_secure_random_key_here
PORT=8501

# --- Email Notifications (Audit Scheduling) ---
SMTP_EMAIL=your_email@domain.com
SMTP_PASSWORD=your_email_app_password_here
